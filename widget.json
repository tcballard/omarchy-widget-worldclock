{
  "schemaVersion": 2,
  "kind": "desktop-widget",
  "coreApi": 3,
  "id": "io.github.tcballard.worldclock",
  "name": "World Clock",
  "version": "0.1.2",
  "entryPoint": "WorldClock.qml",
  "defaults": {
    "cities": [
      {
        "label": "London",
        "zone": "Europe/London"
      },
      {
        "label": "New York",
        "zone": "America/New_York"
      },
      {
        "label": "Chicago",
        "zone": "America/Chicago"
      },
      {
        "label": "Amsterdam",
        "zone": "Europe/Amsterdam"
      },
      {
        "label": "Tokyo",
        "zone": "Asia/Tokyo"
      },
      {
        "label": "Sydney",
        "zone": "Australia/Sydney"
      }
    ],
    "displayMode": "digital",
    "homeZone": "Europe/London"
  },
  "settingsEntryPoint": "Settings.qml",
  "families": [
    "small",
    "medium",
    "large"
  ],
  "defaultFamily": "medium",
  "requires": [
    "acknowledged-actions",
    "frame-settings",
    "command-dependencies"
  ],
  "dependencies": {
    "commands": [
      "bash",
      "date",
      "timeout"
    ]
  }
}
