{
  "schemaVersion": 1,
  "kind": "desktop-widget",
  "coreApi": 1,
  "id": "io.github.tcballard.worldclock",
  "name": "World Clock",
  "version": "0.1.1",
  "entryPoint": "WorldClock.qml",
  "defaultSize": "standard",
  "sizes": {
    "compact": {"width": 280, "height": 280},
    "standard": {"width": 420, "height": 260},
    "wide": {"width": 580, "height": 280}
  },
  "defaults": {
    "cities": [
      {"label": "London", "zone": "Europe/London"},
      {"label": "New York", "zone": "America/New_York"},
      {"label": "Chicago", "zone": "America/Chicago"},
      {"label": "Amsterdam", "zone": "Europe/Amsterdam"},
      {"label": "Tokyo", "zone": "Asia/Tokyo"},
      {"label": "Sydney", "zone": "Australia/Sydney"}
    ]
  }
}
